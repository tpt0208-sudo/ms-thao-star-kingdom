ents/MenuIcon.tsx\n/src/components/NavigationCards.tsx\n/src/components/NotificationDetailModal.tsx\n/src/components/NotificationsDrawer.tsx\n/src/components/RandomPickerView.tsx\n/src/components/RewardsView.tsx\n/src/components/SchoolEmblem.tsx\n/src/components/SettingsBackupView.tsx\n/src/components/SettingsModal.tsx\n/src/components/Sidebar.tsx\n/src/components/StarPopover.tsx\n/src/components/StudentCard.tsx\n/src/components/StudentPortalView.tsx\n/src/components/StudentsView.tsx\n/src/components/ToastNotification.tsx\n/src/index.css\n/src/main.tsx\n/src/services/api.ts\n/src/services/firebase.ts\n/src/services/offlineSync.ts\n/src/types.ts\n/src/utils/audioManager.ts\n/src/utils/effects.ts\n/src/utils/timePeriodService.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.3.3\n@vitejs/plugin-react: ^6.1.1\ncanvas-confetti: ^1.9.4\ndotenv: ^17.2.3\nexpress: ^4.21.2\nfirebase: ^13.1.0\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nqrcode: ^1.5.4\nreact: ^19.0.1\nreact-dom: ^19.0.1\nsharp: ^0.35.5\nvite: ^8.3.0\nxlsx: ^0.18.5\n\nThe following devDependencies are installed:\n@types/canvas-confetti: ^1.9.0\n@types/express: ^4.17.21\n@types/node: ^22.14.0\n@types/qrcode: ^1.5.6\n@types/react: ^19.3.0\n@types/react-dom: ^19.3.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.3.3\ntsx: ^4.21.0\ntypescript: ^7.0.2\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /firebase-applet-config.json ---\n```json\n{\n  \"projectId\": \"marklar-fiber-7vr20\",\n  \"appId\": \"1:352651636087:web:793fe5238e54c70b0d0572\",\n  \"apiKey\": \"AIzaSyDkPI8NxEWbQ4k2dhTUJNSwqGYr83o0pAc\",\n  \"authDomain\": \"marklar-fiber-7vr20.firebaseapp.com\",\n  \"firestoreDatabaseId\": \"ai-studio-remixverokmsthao-b02fd494-af21-403b-8767-76a17cf6b734\",\n  \"storageBucket\": \"marklar-fiber-7vr20.firebasestorage.app\",\n  \"messagingSenderId\": \"352651636087\",\n  \"measurementId\": \"\",\n  \"oAuthClientId\": \"352651636087-d5qkhqu4v6en4p6ikj4eq2inm3fq41f3.apps.googleusercontent.com\",\n  \"recaptchaSiteKey\": \"\"\n}\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"vi\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Ms. Thao\'s Star Kingdom - V\306\260\306\241ng qu\341\273\221c ng\303\264i sao</title>\n    <meta name=\"description\" content=\"H\341\273\207 th\341\273\221ng qu\341\272\243n l\303\275 l\341\273\233p h\341\273\215c ti\341\273\203u h\341\273\215c song ng\341\273\257 Anh - Vi\341\273\207t, qu\341\272\243n l\303\275 thi \304\221ua 4 t\341\273\225, c\341\273\231ng tr\341\273\253 sao tr\341\273\261c ti\341\272\277p tr\303\252n sticker h\341\273\215c sinh, \304\221i\341\273\203m danh, \304\221\341\273\225i th\306\260\341\273\237ng v\303\240 vinh danh.\" />\n    <meta property=\"og:title\" content=\"Ms. Thao\'s Star Kingdom - V\306\260\306\241ng qu\341\273\221c ng\303\264i sao\" />\n    <meta property=\"og:description\" content=\"H\341\273\207 th\341\273\221ng qu\341\272\243n l\303\275 l\341\273\233p h\341\273\215c ti\341\273\203u h\341\273\215c song ng\341\273\257 Anh - Vi\341\273\207t, qu\341\272\243n l\303\275 thi \304\221ua 4 t\341\273\225, c\341\273\231ng tr\341\273\253 sao tr\341\273\261c ti\341\272\277p tr\303\252n sticker h\341\273\215c sinh, \304\221i\341\273\203m danh, \304\221\341\273\225i th\306\260\341\273\237ng v\303\240 vinh danh.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"theme-color\" content=\"#47B5FF\" />\n    <link rel=\"manifest\" href=\"/manifest.json\" />\n    <link rel=\"icon\" type=\"image/png\" href=\"/assets/kingdom/school_logo_v2.png\" />\n    <link rel=\"apple-touch-icon\" href=\"/assets/kingdom/school_logo_v2.png\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-[#F0F8FF] font-[\'Nunito\',sans-serif] text-[#263C72] antialiased select-none\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n    <script>\n      if (\'serviceWorker\' in navigator && window.location.protocol.startsWith(\'http\')) {\n        window.addEventListener(\'load\', () => {\n          navigator.serviceWorker.register(\'/sw.js\').catch((err) => {\n            console.debug(\'ServiceWorker registration skipped:\', err);\n          });\n        });\n      }\n    </script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix verokMs. Thao\\u0027s Star Kingdom - V\306\260\306\241ng qu\341\273\221c ng\303\264i saochecklai\",\n  \"description\": \"H\341\273\207 th\341\273\221ng qu\341\272\243n l\303\275 l\341\273\233p h\341\273\215c ti\341\273\203u h\341\273\215c song ng\341\273\257 Anh - Vi\341\273\207t\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect } from \'react\';\nimport { AppState, Role, Student, LibraryCategory, StarTransaction, ClassInfo, AppNotification } from \'./types\';\nimport { api } from \'./services/api\';\nimport { offlineSync } from \'./services/offlineSync\';\nimport { Header } from \'./components/Header\';\nimport { Sidebar, NavTab, navItems, settingsItem } from \'./components/Sidebar\';\nimport { HeroBanner } from \'./components/HeroBanner\';\nimport { NavigationCards } from \'./components/NavigationCards\';\nimport { HomeDashboard } from \'./components/HomeDashboard\';\nimport { StudentsView } from \'./components/StudentsView\';\nimport { ClassTeamsView } from \'./components/ClassTeamsView\';\nimport { RewardsView } from \'./components/RewardsView\';\nimport { HallOfFameView } from \'./components/HallOfFameView\';\nimport { ClassroomToolsView } from \'./components/ClassroomToolsView\';\nimport { ClassNewsView } from \'./components/ClassNewsView\';\nimport { LearningLibraryView } from \'./components/LearningLibraryView\';\nimport { SettingsBackupView } from \'./components/SettingsBackupView\';\nimport { CreateClassModal } from \'./components/CreateClassModal\';\nimport { StudentPortalView } from \'./components/StudentPortalView\';\nimport { LoginPage } from \'./components/LoginPage\';\nimport { ClassQRCodeModal } from \'./components/ClassQRCodeModal\';\nimport { MenuIcon } from \'./components/MenuIcon\';\nimport { DeleteClassModal } from \'./components/DeleteClassModal\';\nimport { NotificationsDrawer } from \'./components/NotificationsDrawer\';\nimport { NotificationDetailModal } from \'./components/NotificationDetailModal\';\nimport { ToastNotification, ActiveToast } from \'./components/ToastNotification\';\nimport { playStarSound, triggerGrandCelebration, stopCelebration } from \'./utils/effects\';\n\nimport {\n  Bell,\n  X,\n  Star,\n  Users,\n  Trophy,\n  Gift,\n  Dice5,\n  BookOpen,\n  Megaphone,\n  Home as HomeIcon,\n  Sparkles,\n  Briefcase,\n  Layers,\n} from \'lucide-react\';\n\nexport default function App() {\n  const [appState, setAppState] = useState<AppState | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Navigation & Role\n  const [currentTab, setCurrentTab] = useState<NavTab>(\'home\');\n  const [currentRole, setCurrentRole] = useState<Role>(\'teacher\');\n  const [currentStudent, setCurrentStudent] = useState<Student | null>(null);\n\n  // Sub-navigation presets\n  const [selectedToolTab, setSelectedToolTab] = useState<\'noise\' | \'timer\' | \'picker\'>(\'noise\');\n  const [selectedLibraryCategory, setSelectedLibraryCategory] = useState<LibraryCategory | \'all\'>(\'all\');\n\n  // Modals & Drawers\n  const [isCreateClassOpen, setIsCreateClassOpen] = useState(false);\n  const [headerClassToDelete, setHeaderClassToDelete] = useState<ClassInfo | null>(null);\n  const [isSettingsOpen, setIsSettingsOpen] = useState(false);\n  const [isNotificationsOpen, setIsNotificationsOpen] = useState(false);\n  const [selectedNotification, setSelectedNotification] = useState<AppNotification | null>(null);\n  const [activeToasts, setActiveToasts] = useState<ActiveToast[]>([]);\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const [isQrModalOpen, setIsQrModalOpen] = useState(false);\n\n  // Authentication & Current User State\n  const [currentUserInfo, setCurrentUserInfo] = useState<{ id: string; email?: string; name: string }>(() => {\n    if (typeof window !== \'undefined\') {\n      try {\n        const saved = localStorage.getItem(\'starkingdom_auth\');\n        if (saved) {\n          const parsed = JSON.parse(saved);\n          const uId = parsed.userId || parsed.email || (parsed.studentId ? `student_${parsed.studentId}` : \'teacher_thao\');\n          return {\n            id: uId,\n            email: parsed.email,\n            name: parsed.displayName || parsed.fullName || \'C\303\264 Th\341\272\243o\',\n          };\n        }\n      } catch (e) {\n        // ignore\n      }\n    }\n    return { id: \'teacher_thao\', email: \'tpt0208@gmail.com\', name: \'C\303\264 Th\341\272\243o\' };\n  });\n\n  const [isAuthenticated, setIsAuthenticated] = useState<boolean>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'portal\') === \'student\' || params.get(\'code\') || params.get(\'student\')) {\n        return true;\n      }\n      try {\n        const saved = localStorage.getItem(\'starkingdom_auth\');\n        if (saved) {\n          const parsed = JSON.parse(saved);\n          return !!parsed.authenticated;\n        }\n      } catch (e) {\n        // ignore\n      }\n    }\n    return false;\n  });\n\n  // Calculate current active userId strictly for notification read tracking\n  const currentUserId =\n    currentRole === \'teacher\'\n      ? currentUserInfo.id || \'teacher_thao\'\n      : currentStudent\n      ? `student_${currentStudent.id}`\n      : \'student_guest\';\n\n  // Read notification IDs set for current user\n  const [readNotificationIds, setReadNotificationIds] = useState<Set<string>>(() => {\n    if (typeof window !== \'undefined\') {\n      try {\n        const cached = localStorage.getItem(`starkingdom_reads_${currentUserId}`);\n        if (cached) {\n          return new Set(JSON.parse(cached));\n        }\n      } catch (e) {}\n    }\n    return new Set<string>();\n  });\n\n  // Keep readNotificationIds in sync with currentUserId & appState\n  useEffect(() => {\n    if (appState && currentUserId) {\n      const serverReads = (appState.notificationReads || [])\n        .filter((r) => r.userId === currentUserId && r.isRead)\n        .map((r) => r.notificationId);\n\n      let localCached: string[] = [];\n      try {\n        const item = localStorage.getItem(`starkingdom_reads_${currentUserId}`);\n        if (item) localCached = JSON.parse(item);\n      } catch (e) {}\n\n      const merged = new Set([...serverReads, ...localCached]);\n      setReadNotificationIds(merged);\n      try {\n        localStorage.setItem(`starkingdom_reads_${currentUserId}`, JSON.stringify(Array.from(merged)));\n      } catch (e) {}\n    }\n  }, [appState?.notificationReads, currentUserId]);\n\n  const isNotificationRead = (notifId: string): boolean => {\n    return readNotificationIds.has(notifId);\n  };\n\n  const handleMarkNotificationAsRead = async (notificationId: string) => {\n    // 1. Optimistic update: mark as read immediately so badge & dot decrease instantly\n    setReadNotificationIds((prev) => {\n      const next = new Set(prev);\n      next.add(notificationId);\n      try {\n        localStorage.setItem(`starkingdom_reads_${currentUserId}`, JSON.stringify(Array.from(next)));\n      } catch (e) {}\n      return next;\n    });\n\n    // 2. Persist to server / database\n    try {\n      await api.markNotificationAsRead(notificationId, currentUserId, appState?.currentClassId);\n    } catch (err) {\n      console.warn(\'Network error marking notification as read; saved to local cache:\', err);\n    }\n  };\n\n  const handleOpenNotification = (notif: AppNotification) => {\n    setSelectedNotification(notif);\n    handleMarkNotificationAsRead(notif.id);\n  };\n\n  const addToast = (notification: AppNotification) => {\n    // Never show a toast for a notification that is already marked as read!\n    if (readNotificationIds.has(notification.id)) return;\n    setActiveToasts((prev) => [\n      ...prev.filter((t) => t.notification.id !== notification.id),\n      { id: `toast_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`, notification, createdAt: Date.now() },\n    ]);\n  };\n\n  const handleDismissToast = (toastId: string) => {\n    setActiveToasts((prev) => prev.filter((t) => t.id !== toastId));\n  };\n\n\n  // Load state on start\n  const fetchState = async () => {\n    try {\n      setLoading(true);\n      const data = await api.getState();\n      setAppState(data);\n      // Cache fresh state for offline use\n      offlineSync.cacheClassState(data);\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  *, ::before, ::after {\n    font-family: \'Nunito\', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif !important;\n  }\n\n  html {\n    font-size: 15px;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  body {\n    font-family: \'Nunito\', sans-serif !important;\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1E293B;\n    letter-spacing: -0.01em;\n  }\n\n  h1, h2, h3, h4, h5, h6, button, input, select, textarea {\n    font-family: \'Nunito\', sans-serif !important;\n  }\n}\n\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes scaleIn {\n  from {\n    opacity: 0;\n    transform: scale(0.92);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n.animate-fade-in {\n  animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n.animate-scale-in {\n  animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* Custom scrollbars for friendly edtech feel */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #CBD5E1;\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #94A3B8;\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(<App />);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(process.cwd(), \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
    }
  }
