# ============================================================================
# Ms. Thao's Star Kingdom – Vương quốc ngôi sao (Production Environment Config)
# ============================================================================

# 1. Server & Environment
NODE_ENV="production"
PORT="3000"
APP_URL="https://your-production-domain.example.com"

# 2. Authentication & Session Security (Required in Production)
# Replace with a strong 32+ byte random secret string
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_HMAC_SECRET_KEY"

# Comma-separated list of authorized Teacher / Admin email addresses
TEACHER_EMAILS="tpt0208@gmail.com,cothao@gmail.com,admin@starkingdom.edu.vn"

# Comma-separated list of allowed Teacher password(s) for Email/Password login
TEACHER_PASSWORD="REPLACE_WITH_STRONG_TEACHER_PASSWORD"

# 3. Optional AI & External Services
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 4. Database Storage Options
# Set to "true" to run with sanitized synthetic demo data (recommended for public demos/testing)
USE_DEMO_DATA="false"
# Custom database path (defaults to data/db.json or data/demo_db.json when USE_DEMO_DATA=true)
# DB_FILE="data/db.json"


